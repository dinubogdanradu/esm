    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "gh-pages": "^4.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
